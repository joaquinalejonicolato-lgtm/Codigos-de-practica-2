Clase Libro
    //defino los atributos (todos los atributos son objetos)
    String nombre nuevaInstancia String()
    String autor nuevaInstancia String()
    Integrer anioPublicacion nuevaInstancia Integrer()
    //El atributo esta compuesto por: "tipo de dato": Integrer, el objeto ("anioPublicacion")
    //la palabra reservada "nuevaInstancia" y el constructor utilizado ("Integrer()")

    //      Integrer, String, Boolean, Float, Date, ETC los vamos a tomar como clases
    Integrer anioActual nuevaInstancia Integrer()

    //un metodo que nunca devulve un valor y se llama igual que la clase es un constructor
    //si no recibe parametros es el "constructor por default"

    metodo Libro() //Constructor
        autor = "Anonimo"
        anioPublicacion = -1
        anioActual = 2026
        nombre = "Joaco"
    fin metodo

    //metodo que calcula los años de antiguedad del Libro
    metodo Integrer calcularAntiguedad()
        retornar: anioActual - anioPublicacion
    fin metodo


    //metodo setter para asignarle un valor a un atributo
    //No devulve valores y recibe un parametro
    //Solo hace una asignacion
    metodo asignarAutor(String nuevoAutor)
        autor = nuevoAutor
    fin metodo

    metodo asignarAnioDePublicacion(Integrer nuevoAnioDePublicacion)
        anioPublicacion = nuevoAnioDePublicacion
    fin metodo

    metodo asignarNombre(String nuevoNombre)
        nombre = nuevoNombre
    fin metodo

    //metodo getter para devolver valores
    //Siempre devulve valores y niunca recibe parametros
    metodo String obtenerAutor()
        retornar: autor
    fin  metodo
fin clase
        

