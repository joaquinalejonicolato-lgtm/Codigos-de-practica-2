//Implementacion de getters y setters
clase Compania
    //atributos
    String nombre nuevaInstancia String()
    String domicilio nuevaInstancia String()

    //contructorp or default
    metodo Compania()
    fin metodo

    //getters
    // Devuelve Valores del atributo al que corresponde
    metodo String obtenerDomicilio()
        retornar: domicilio
